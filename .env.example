# Vercel > Project > Settings > Environment Variables içine girilecek değerler.
# Bu dosyaya gerçek anahtar yazma; depoya gönderilir.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Araç tanıma (Claude). console.anthropic.com
ANTHROPIC_API_KEY=
# İsteğe bağlı: kullanılacak model
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Fotoğraftan 3D üretim (Meshy). meshy.ai > API
MESHY_API_KEY=
# İsteğe bağlı: model sürümü ve kullanıcı başına günlük üretim sınırı
# MESHY_MODEL=latest
# MODEL_DAILY_LIMIT=3
