# Vercel > Project > Settings > Environment Variables içine girilecek değerler.
# Bu dosyaya gerçek anahtar yazma; depoya gönderilir.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Araç tanıma (Claude). console.anthropic.com
ANTHROPIC_API_KEY=
# İsteğe bağlı: kullanılacak model
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Fotoğraftan 3D üretim (Meshy). meshy.ai > API
MESHY_API_KEY=
# İsteğe bağlı: model sürümü ve kullanıcı başına günlük üretim sınırı
# MESHY_MODEL=latest
# MODEL_DAILY_LIMIT=3

# Üretim türü: toon (varsayılan, çizgi film tarzı çizimler) ya da 3d (fotoğraftan 3D model)
# MODEL_MODE=toon
# Çizilecek açılar: fq=ön çapraz, l=yan, f=ön, b=arka, rq=arka çapraz, t=üst. Her açı ayrı kredi harcar.
# TOON_VIEWS=fq,l,f
# Çizim modeli (Meshy image-to-image): nano-banana (3 kredi), nano-banana-2 (6), nano-banana-pro (9)
# MESHY_IMAGE_MODEL=nano-banana-pro
